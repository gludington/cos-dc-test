---
import { render } from "astro:content";
import Layout from "../../../../../layouts/Layout.astro";
import { getSiteConfig } from "../../../../../lib/config";
import { getPublishedPosts } from "../../../../../lib/posts";
import { blogRoute, authorRoute, tagRoute, rootCrumbs, formatDate } from "../../../../../lib/routes";
import { slugifyTag } from "../../../../../lib/tags";

const siteName = getSiteConfig().siteName;

export async function getStaticPaths() {
  const { blogsSegment } = getSiteConfig();
  // Not just filtering the listing -- excluding an unpublished post here
  // means it gets no generated page at all, so its old URL 404s on the
  // next deploy rather than staying reachable by direct link.
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { world: post.data.world, section: blogsSegment, blog: post.data.blogSlug, slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const wasUpdated = post.data.updatedAt !== post.data.publishedAt;
const crumbs = rootCrumbs(post.data);
---

<Layout title={post.data.title}>
  <nav class="crumbs">
    <a href="/">{siteName}</a>
    {
      crumbs.map((c) => (
        <>
          {" / "}
          <a href={c.href}>{c.label}</a>
        </>
      ))
    }
    {" / "}
    <a href={blogRoute(post.data)}>{post.data.blogTitle}</a>
  </nav>
  <h1>{post.data.title}</h1>
  <div class="meta">
    {post.data.author.image && <img class="avatar" src={post.data.author.image} alt="" />}
    by <a href={authorRoute(post.data)}>{post.data.author.name}</a> · published {formatDate(post.data.publishedAt)}
    {wasUpdated && <> · updated {formatDate(post.data.updatedAt)}</>}
  </div>
  {
    post.data.tags.length > 0 && (
      <div class="meta">
        In{" "}
        {post.data.tags.map((tagName, i) => (
          <>
            <a href={tagRoute({ world: post.data.world, tagSlug: slugifyTag(tagName) })}>{tagName}</a>
            {i < post.data.tags.length - 1 && ", "}
          </>
        ))}
      </div>
    )
  }
  <section>
    <Content />
  </section>
</Layout>
