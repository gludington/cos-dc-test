---
import type { CollectionEntry } from "astro:content";
import { postRoute, authorRoute, blogRoute, formatDate } from "../lib/routes";

// The N most recently published posts within whatever scope the caller
// hands in -- interleaved across every blog/author, not grouped. Deliberately
// takes posts as a prop rather than fetching its own: the caller decides the
// scope (one world's posts for a per-world index, say), this just picks the
// newest N and renders them.
interface Props {
  posts: CollectionEntry<"posts">[];
  count?: number;
}
const { posts, count = 5 } = Astro.props;

const recent = posts
  .slice()
  .sort((a, b) => b.data.publishedAt - a.data.publishedAt)
  .slice(0, count);
---

{
  recent.length > 0 && (
    <section>
      <h2>Recent Posts</h2>
      <ul class="plain">
        {recent.map((post) => (
          <li>
            <a href={postRoute(post.data)}>{post.data.title}</a>
            <div class="meta">
              by <a href={authorRoute(post.data)}>{post.data.author.name}</a> in{" "}
              <a href={blogRoute(post.data)}>{post.data.blogTitle}</a> · {formatDate(post.data.publishedAt)}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}
