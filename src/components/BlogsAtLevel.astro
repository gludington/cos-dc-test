---
import { blogRoute, authorRoute } from "../lib/routes";
import type { BlogInfo } from "../lib/sections";

// Blogs living directly at one level of the root hierarchy -- e.g. on the
// homepage (the root level itself), blogs with no root at all; on a section
// page, blogs whose root resolves to exactly that section, no deeper.
interface Props {
  blogs: BlogInfo[];
}
const { blogs } = Astro.props;
---

{
  blogs.length > 0 && (
    <section>
      <h2>Blogs</h2>
      <ul class="plain">
        {blogs.map((blog) => (
          <li>
            <a href={blogRoute(blog)}>{blog.blogTitle}</a>
            <div class="meta">
              {blog.authorImage && <img class="avatar" src={blog.authorImage} alt="" />}
              by <a href={authorRoute(blog)}>{blog.authorName}</a>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}
