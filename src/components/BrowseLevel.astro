---
import { blogRoute, authorRoute, sectionRoute } from "../lib/routes";
import type { BlogInfo, SectionInfo } from "../lib/sections";

// Merges what used to be two separate panels (blogs at this level, and
// sections one level down) into one -- sections first (they're categories,
// i.e. browsing structure), then blogs living directly at this level. Kept
// as a single panel/heading rather than two: on a page that's otherwise
// just a recent-posts feed, two nearly-identical "here's a list of links"
// panels back to back read as clutter, not structure.
interface Props {
  sections: SectionInfo[];
  blogs: BlogInfo[];
}
const { sections, blogs } = Astro.props;
---

{
  (sections.length > 0 || blogs.length > 0) && (
    <section class="panel">
      <h2 class="panel-title">Browse</h2>
      <ul class="entry-list">
        {sections.map((s) => (
          <li class="entry">
            <a class="entry-title" href={sectionRoute(s.world, s.slug)}>
              {s.label}
            </a>
            <div class="meta">Section</div>
          </li>
        ))}
        {blogs.map((blog) => (
          <li class="entry">
            <a class="entry-title" href={blogRoute(blog)}>
              {blog.blogTitle}
            </a>
            <div class="meta">
              {blog.authorImage && <img class="avatar" src={blog.authorImage} alt="" />}
              by <a href={authorRoute(blog)}>{blog.authorName}</a>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}
