---
import { journalRoute, authorRoute, sectionRoute } from "../lib/routes";
import type { JournalInfo, SectionInfo } from "../lib/sections";

// Merges what used to be two separate panels (journals at this level, and
// sections one level down) into one -- sections first (they're categories,
// i.e. browsing structure), then journals living directly at this level. Kept
// as a single panel/heading rather than two: on a page that's otherwise
// just a recent-posts feed, two nearly-identical "here's a list of links"
// panels back to back read as clutter, not structure.
interface Props {
  sections: SectionInfo[];
  journals: JournalInfo[];
}
const { sections, journals } = Astro.props;
---

{
  (sections.length > 0 || journals.length > 0) && (
    <section class="panel">
      <h2 class="panel-title">Browse</h2>
      <ul class="entry-list">
        {sections.map((s) => (
          <li class="entry">
            <a class="entry-title" href={sectionRoute(s.world, s.slug)}>
              {s.label}
            </a>
            <div class="meta">Section</div>
          </li>
        ))}
        {journals.map((journal) => (
          <li class="entry">
            <a class="entry-title" href={journalRoute(journal)}>
              {journal.journalTitle}
            </a>
            <div class="meta">
              {journal.authorImage && <img class="avatar" src={journal.authorImage} alt="" />}
              by <a href={authorRoute(journal)}>{journal.authorName}</a>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}
