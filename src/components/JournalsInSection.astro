---
import { journalRoute, authorRoute } from "../lib/routes";
import type { JournalWithSubPath } from "../lib/sections";

// Every journal under a section, recursively -- see journalsInSubtree() in
// lib/sections.ts for why this (not just the journals directly at that exact
// level) is what a section page shows: a section with real sub-sections
// often has little or nothing sitting directly on it. Each entry notes
// which sub-section it actually lives in when it's not directly here.
interface Props {
  entries: JournalWithSubPath[];
}
const { entries } = Astro.props;
const sorted = entries.slice().sort((a, b) => a.journal.journalTitle.localeCompare(b.journal.journalTitle));
---

{
  sorted.length > 0 && (
    <section class="panel">
      <h2 class="panel-title">Journals</h2>
      <ul class="entry-list">
        {sorted.map(({ journal, subPath }) => (
          <li class="entry">
            <a class="entry-title" href={journalRoute(journal)}>{journal.journalTitle}</a>
            <div class="meta">
              {journal.authorImage && <img class="avatar" src={journal.authorImage} alt="" />}
              by <a href={authorRoute(journal)}>{journal.authorName}</a>
              {subPath.length > 0 && <> · in {subPath.join(" / ")}</>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}
