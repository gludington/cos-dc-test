---
import { getSiteConfig, resolveDataTheme } from "../lib/config";
import "../styles/tokens.css";
import "../styles/base.css";
import ThemeSelector from "../components/ThemeSelector.astro";

interface Props {
  title: string;
}
const { title } = Astro.props;
const siteConfig = getSiteConfig();
// Selects a :root[data-theme="..."] block already compiled into
// styles/tokens.css -- see resolveDataTheme()'s doc comment in lib/config.ts.
const dataTheme = resolveDataTheme(siteConfig.theme);
---

<!doctype html>
<html lang="en" data-theme={dataTheme ?? undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {siteConfig.siteName}</title>
    {/* Visitor override is opt-in (Foundry's "Allow Visitor Theme
        Override" setting) -- when it's off, Site Theme is authoritative
        for everyone and neither this script nor the picker below ships at
        all, not just hidden. */}
    {siteConfig.allowThemeOverride && (
      <script is:inline>
        try {
          const savedTheme = localStorage.getItem("site-theme");
          if (savedTheme) {
            document.documentElement.setAttribute("data-theme", savedTheme);
          }
        } catch {
          // Storage inaccessible (e.g. some private-browsing modes) -- fall
          // back to whatever Site Theme baked into the page at build time.
        }
      </script>
    )}
    {/* The built-in default look's two type families -- an inscriptional
        display face for headings, an old-style serif for body text. Both
        have a same-era system-font fallback in styles/tokens.css, so
        nothing renders unstyled while these load, and a theme that
        overrides --font-heading/--font-body entirely never pays for this
        request having mattered at all. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap"
    />
  </head>
  <body>
    <main>
      {siteConfig.allowThemeOverride && <ThemeSelector />}
      <slot />
    </main>
  </body>
</html>
