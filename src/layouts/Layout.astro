---
import { getSiteConfig, resolveThemeUrl } from "../lib/config";

interface Props {
  title: string;
}
const { title } = Astro.props;
const themeUrl = resolveThemeUrl(getSiteConfig().theme);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Wikiworld</title>
    <style>
      /* Wrapped in a named layer, not relying on source/injection order --
         Astro hoists/reinjects <style> blocks using its own internal
         logic, so where this tag sits in the template doesn't reliably
         control final output order. Per the CSS spec, ANY unlayered
         stylesheet (a plain external theme .css, no @layer wrapper) always
         wins over ANY layered one, regardless of specificity or document
         order -- so a theme reliably overrides this no matter what Astro
         does with placement. */
      @layer base {
      :root {
        color-scheme: light dark;
        --fg: #1a1a1a;
        --bg: #fdfdfb;
        --muted: #666;
        --accent: #6b4fbb;
        --border: #ddd;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --fg: #e8e6e3;
          --bg: #17161a;
          --muted: #9a978f;
          --accent: #b39ddb;
          --border: #333;
        }
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: system-ui, -apple-system, sans-serif;
        line-height: 1.6;
      }
      main {
        max-width: 46rem;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 6rem;
      }
      a {
        color: var(--accent);
      }
      nav.crumbs {
        font-size: 0.9rem;
        color: var(--muted);
        margin-bottom: 1.5rem;
      }
      nav.crumbs a {
        color: var(--muted);
      }
      h1 {
        margin-top: 0;
      }
      .tag {
        display: inline-block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--muted);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 0.15rem 0.6rem;
        margin-bottom: 1rem;
      }
      section {
        margin-top: 2.5rem;
      }
      section h2 {
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--muted);
        border-bottom: 1px solid var(--border);
        padding-bottom: 0.4rem;
      }
      ul.plain {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      ul.plain li {
        padding: 0.35rem 0;
        border-bottom: 1px dotted var(--border);
      }
      .ext {
        color: var(--muted);
      }
      .meta {
        font-size: 0.85rem;
        color: var(--muted);
        margin-top: 0.15rem;
      }
      .meta a {
        color: var(--muted);
      }
      nav.pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 2rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
        font-size: 0.9rem;
      }
      .avatar {
        width: 1.4em;
        height: 1.4em;
        border-radius: 50%;
        object-fit: cover;
        vertical-align: -0.35em;
        margin-right: 0.4em;
      }
      } /* end @layer base */
    </style>
    {/* Overrides the @layer base rules above regardless of where Astro
        actually places this tag in the built output -- see the comment on
        @layer base. */}
    {themeUrl && <link rel="stylesheet" href={themeUrl} />}
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
