---
import { getSiteConfig, resolveThemeUrl } from "../lib/config";
import "../styles/tokens.css";
import "../styles/base.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
const siteConfig = getSiteConfig();
const themeUrl = resolveThemeUrl(siteConfig.theme);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {siteConfig.siteName}</title>
    {/* The built-in default look's two type families -- an inscriptional
        display face for headings, an old-style serif for body text. Both
        have a same-era system-font fallback in styles/tokens.css, so
        nothing renders unstyled while these load, and a theme that
        overrides --font-heading/--font-body entirely never pays for this
        request having mattered at all. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap"
    />
    {/* Overrides styles/base.css's @layer base rules regardless of where
        Astro actually places this tag in the built output: per the CSS
        spec, ANY unlayered stylesheet (a plain external theme .css, no
        @layer wrapper) always wins over ANY layered one, regardless of
        specificity or document order -- so a theme reliably overrides the
        built-in default no matter what Astro does with tag placement. */}
    {themeUrl && <link rel="stylesheet" href={themeUrl} />}
  </head>
  <body>
    <main class="site">
      <slot />
    </main>
  </body>
</html>
